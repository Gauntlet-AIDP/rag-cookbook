# Copied to .env by init.sh. Placeholders only; no real keys are needed.
MONGO_DB_URL=mongodb://mongo:27017/?directConnection=true
OPENAI_API_KEY=unused
PINECONE_API_KEY=unused
LANGCHAIN_API_KEY=unused
LANGCHAIN_TRACING_V2=false
# claude-cli (default) or manual
LLM_BACKEND=claude-cli
LLM_HELPER_URL=http://claude-relay:8765/complete
# init.sh fills this from claude-helper/.token
LLM_HELPER_TOKEN=
# Model the helper runs; start the helper with the same value. Part of the reply cache key
CLAUDE_MODEL=sonnet
# Max successful (uncached) Claude calls per process; raise it for full graph builds and evals
LLM_MAX_CALLS=50
# Cap eval cases to limit Claude calls; empty runs all of them, values <= 0 are rejected
EVAL_MAX_CASES=1
# Modules 04+: init.sh replaces the password placeholder with a random value
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme
NEO4J_URI=bolt://neo4j:7687
# Module 05: agent loop cap; the upstream default is higher
MAX_ITERATIONS=1
